+/* Whether the BO of a resource gets a cached CPU mapping (PAN_BO_WB_MMAP).
+ * The accesses of such a BO go through panfrost_ptr_map/unmap, which do the
+ * cache maintenance. Left out, i.e. mapped non-cacheable as before:
+ *  - buffers: written through unsynchronized and persistent mappings while
+ *    the GPU uses them, and read by the driver outside of a transfer (index
+ *    min/max, query results);
+ *  - anything that may be mapped persistently or coherently;
+ *  - AFBC/AFRC and other modifiers the CPU does not access directly (their
+ *    headers are written and read outside of a transfer).
+ */
+static bool
+panfrost_resource_wants_wb_mmap(struct panfrost_device *dev,
+                                const struct panfrost_resource *rsrc)
+{
+   if (!panfrost_bo_wb_mmap_supported(dev))
+      return false;
+
+   if (rsrc->base.target == PIPE_BUFFER)
+      return false;
+
+   if (rsrc->base.flags &
+       (PIPE_RESOURCE_FLAG_MAP_PERSISTENT | PIPE_RESOURCE_FLAG_MAP_COHERENT))
+      return false;
+
+   return rsrc->modifier == DRM_FORMAT_MOD_LINEAR ||
+          rsrc->modifier == DRM_FORMAT_MOD_ARM_16X16_BLOCK_U_INTERLEAVED;
+}
+
+/* The range of the BO that a transfer of a linear or tiled resource touches:
+ * one contiguous range from the first to the last byte of the box, for the
+ * cache maintenance of a cached mapping. */
+static void
+panfrost_transfer_bo_range(const struct panfrost_resource *rsrc, unsigned level,
+                           const struct pipe_box *box, uint64_t *offset,
+                           uint64_t *size)
+{
+   const struct pan_image_slice_layout *slice =
+      &rsrc->plane.layout.slices[level];
+   bool is_3d = rsrc->image.props.dim == MALI_TEXTURE_DIMENSION_3D;
+   uint64_t layer_stride = is_3d ? slice->tiled_or_linear.surface_stride_B
+                                 : rsrc->plane.layout.array_stride_B;
+   unsigned depth = MAX2(box->depth, 1);
+
+   *offset = slice->offset_B + (uint64_t)box->z * layer_stride;
+
+   if (rsrc->modifier == DRM_FORMAT_MOD_LINEAR) {
+      enum pipe_format format = rsrc->image.props.format;
+      uint64_t bytes_per_block = util_format_get_blocksize(format);
+      uint64_t row_stride = slice->tiled_or_linear.row_stride_B;
+      struct pipe_box box_blocks;
+
+      u_box_pixels_to_blocks(&box_blocks, box, format);
+
+      *offset += box_blocks.y * row_stride + box_blocks.x * bytes_per_block;
+      *size = (depth - 1) * layer_stride +
+              (uint64_t)(MAX2(box_blocks.height, 1) - 1) * row_stride +
+              box_blocks.width * bytes_per_block;
+   } else {
+      /* Tiled: whole layers of the level */
+      *size = (depth - 1) * layer_stride +
+              (is_3d ? layer_stride : slice->size_B);
+   }
+}
