+/* Cached CPU mappings of BOs on a GPU that is not coherent with the CPU
+ * caches. The kmod layer knows the flag and the cache maintenance (Linux'
+ * panthor >= 1.7), the Vulkan driver uses them; the GL driver did not.
+ * PAN_WB_MMAP=0 in the environment switches the cached mappings off.
+ */
+bool
+panfrost_bo_wb_mmap_supported(struct panfrost_device *dev)
+{
+   static int enabled = -1;
+
+   if (enabled < 0)
+      enabled = debug_get_bool_option("PAN_WB_MMAP", true);
+
+   return enabled && (dev->kmod.dev->props.supported_bo_flags &
+                      PAN_KMOD_BO_FLAG_WB_MMAP);
+}
+
+static void
+panfrost_bo_map_sync(struct panfrost_bo *bo, uint64_t offset, uint64_t size,
+                     enum pan_kmod_bo_sync_type type)
+{
+   if (!(bo->flags & PAN_BO_WB_MMAP) || !bo->ptr.cpu)
+      return;
+
+   uint64_t bo_size = panfrost_bo_size(bo);
+
+   if (offset >= bo_size)
+      return;
+
+   size = MIN2(size, bo_size - offset);
+   if (!size)
+      return;
+
+   pan_kmod_queue_bo_map_sync(bo->kmod_bo, offset,
+                              (uint8_t *)bo->ptr.cpu + offset, size, type);
+
+   /* Nothing is deferred: the callers sync right before the CPU access or
+    * right after it, which may be the last thing before the GPU job. */
+   pan_kmod_flush_bo_map_syncs(bo->dev->kmod.dev);
+}
+
+/* To be called before the CPU reads a range the GPU may have written, or
+ * writes parts of it, once the GPU is done with the BO: the CPU cache may
+ * hold lines of the range from before the GPU wrote it. */
+void
+panfrost_bo_sync_for_cpu(struct panfrost_bo *bo, uint64_t offset, uint64_t size)
+{
+   panfrost_bo_map_sync(bo, offset, size,
+                        PAN_KMOD_BO_SYNC_CPU_CACHE_FLUSH_AND_INVALIDATE);
+}
+
+/* To be called after the CPU wrote a range, before a GPU job reads it. */
+void
+panfrost_bo_sync_for_gpu(struct panfrost_bo *bo, uint64_t offset, uint64_t size)
+{
+   panfrost_bo_map_sync(bo, offset, size, PAN_KMOD_BO_SYNC_CPU_CACHE_FLUSH);
+}
